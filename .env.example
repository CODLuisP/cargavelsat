# Copiar a .env y completar. NO comitear .env.
# Las claves usan la convención de ASP.NET Core: "Seccion__Clave" = "Seccion:Clave".

# --- MySQL (contenedor mysql-gts en la red app-net) ---
ConnectionStrings__Gts=Server=mysql-gts;Port=3306;Database=gts;Uid=gtsuser;Pwd=CAMBIAR;Charset=utf8mb4;Pooling=true;Allow User Variables=True;MinimumPoolSize=0;MaximumPoolSize=20;ConnectionTimeout=60;ConnectionLifeTime=55;ConnectionReset=true;DefaultCommandTimeout=600;
ConnectionStrings__Dbv16=Server=mysql-gts;Port=3306;Database=dbv16_01;Uid=gtsuser;Pwd=CAMBIAR;Charset=utf8mb4;Pooling=true;Allow User Variables=True;MinimumPoolSize=0;MaximumPoolSize=20;ConnectionTimeout=60;ConnectionLifeTime=55;ConnectionReset=true;DefaultCommandTimeout=600;

# --- Cloudflare R2 ---
R2__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
R2__AccessKeyId=CAMBIAR
R2__SecretAccessKey=CAMBIAR
R2__Bucket=data-semanal
R2__Region=auto

# --- API ---
# Generar con: openssl rand -hex 24
Restauracion__ApiKey=CAMBIAR

# --- Opcionales (valores por defecto en appsettings.json) ---
# Restauracion__RangoMaximoDias=62
# Restauracion__EspacioMinimoGb=5
# Restauracion__MinutosPorTabla=4
# Restauracion__TimeoutImportacionMinutos=90
# Restauracion__TimeoutInsertSegundos=1800
# Restauracion__MysqlArgsExtra=
# R2__IntentosDescarga=4
